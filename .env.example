# LLM Provider Configuration (gemini or groq)
LLM_PROVIDER=gemini

# Google Gemini API Key (Get a free key at: https://aistudio.google.com/)
GEMINI_API_KEY=

# Groq API Key (Optional alternative, free at: https://console.groq.com/)
GROQ_API_KEY=

# Embeddings: google or sentence-transformers
EMBEDDING_PROVIDER=google
